# Copy to .env (never commit .env). docker compose reads it automatically.

# Required. Use a long URL-safe value, e.g. `openssl rand -hex 32`;
# it is embedded in a redis:// URI, so avoid @ / : # characters.
REDIS_PASSWORD=

# Where the engine reads dump1090 from. Defaults to a feeder on the Docker host;
# set to `dump1090` when running with `--profile sdr`.
DUMP1090_HOST=host.docker.internal

# Host group id that owns the RTL-SDR device nodes (--profile sdr only).
# Defaults to 46 (plugdev on Debian/Ubuntu/Raspberry Pi OS).
# SDR_GID=46
