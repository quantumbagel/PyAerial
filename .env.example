# Copy to .env (never commit .env). docker compose reads it automatically.

# Required: without it the redis-config service fails and nothing starts.
# Compose hands it to the containers as a secret file, never as an environment
# variable. It is written into redis.conf, so use a long value without spaces
# or quotes, e.g. `openssl rand -hex 32`.
REDIS_PASSWORD=

# Where the engine reads dump1090 from. Defaults to a feeder on the Docker host;
# set to `dump1090` when running with `--profile sdr`.
DUMP1090_HOST=host.docker.internal

# Host port (on 127.0.0.1) for the portal's dump1090-compatible Beast feed.
# Defaults to 30105 (the container port too) because dump1090 uses 30005.
# BEAST_PUBLISH_PORT=30105

# Webhook URLs do not belong here: put each in a file under ./secrets/ and see
# the webhook_url secret in docker-compose.yml.

# Host group id that owns the RTL-SDR device nodes (--profile sdr only).
# Defaults to 46 (plugdev on Debian/Ubuntu/Raspberry Pi OS).
# SDR_GID=46
